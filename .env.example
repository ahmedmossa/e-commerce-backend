# ============================================================================
# File: .env.example
# Track: Track 01 - Infrastructure & Core Setup
# Owner: Ahmed Ibrahim Mossa (Team Leader)
# Description: Environment variables template for Core Team 6 E-Commerce API.
#              Copy this file to `.env` locally and replace placeholder values.
#              NEVER commit the real `.env` file to version control.
# ============================================================================

# Server Configuration (Track 01)
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration - MongoDB Atlas (Track 01)
# URL-encode special characters in password if needed.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority

# Authentication & JWT (Track 02)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
OTP_SECRET=otp_secret_key

# Cloudinary Media Storage (Track 04)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service / Nodemailer (Track 02 & Track 08)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Stripe Payment Gateway (Track 09)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret